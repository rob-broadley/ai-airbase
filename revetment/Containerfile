# SPDX-License-Identifier: AGPL-3.0-or-later
# Tools installed inside this image are separate works under their own licences.
FROM registry.fedoraproject.org/fedora-toolbox:44

# Install core tools
RUN --mount=type=cache,target=/var/cache/dnf <<DNF_INSTALL
dnf install -y --setopt=install_weak_deps=False \
    gh \
    gitleaks \
    jq \
    nix-core \
    nix-filesystem \
    nodejs \
    npm \
    trivy \
    uv
DNF_INSTALL

# Install GitHub Copilot CLI
RUN --mount=type=cache,target=/root/.npm <<NPM_INSTALL
npm install -g @github/copilot@1.0.40
NPM_INSTALL

# Install extra tools via uv
ENV UV_TOOL_BIN_DIR=/usr/local/bin
ENV UV_TOOL_DIR=/usr/local/share/uv/tools
ENV UV_LINK_MODE=copy
RUN --mount=type=cache,target=/root/.cache/uv <<UV_TOOL_INSTALL
uv tool install ast-grep-cli
uv tool install lizard
UV_TOOL_INSTALL

# Configure nix; set HOME after all tool installs so build-time cache mounts
# targeting /root/.npm and /root/.cache/uv are not redirected.
ENV NIX_CONF_DIR=/etc/nix
COPY etc/nix/ /etc/nix/

# Create home directory for the copilot user (any host UID can write to it via
# --passwd-entry at runtime) and the /workspace mount point. Allow any user
# (including the dynamic copilot UID) to write to the nix store; the container
# boundary is the security perimeter and sticky bit prevents deletion by others.
ENV HOME=/home/copilot
ENV WORKSPACE=/workspace
ENV NIX_DIR=/nix
ENV NIX_STORE=$NIX_DIR/store
RUN <<PERMISSIONS
mkdir -p \
    $HOME \
    $WORKSPACE \
    $NIX_DIR/store \
    $NIX_DIR/var/nix/profiles \
    $NIX_DIR/var/nix/gcroots
chmod -R 1777 \
    $HOME \
    $WORKSPACE \
    $NIX_DIR
# Pre-create the nix profile symlink so PATH resolution works immediately
# after a recreate, even before the user runs nix profile add.
# The symlink target ($HOME/.local/state/nix/profiles/profile) lives on the
# persistent nix-profile volume and is populated at runtime.
mkdir -p $HOME/.local/state/nix/profiles
ln -s $HOME/.local/state/nix/profiles/profile $HOME/.nix-profile
PERMISSIONS

# Ensure tools installed by the runtime user via `uv tool install`
# are installed to a writable directory which is on the PATH.
ENV UV_TOOL_BIN_DIR=$HOME/.local/bin
ENV UV_TOOL_DIR=$HOME/.local/share/uv/tools
ENV PATH=$UV_TOOL_BIN_DIR:$HOME/.nix-profile/bin:$PATH

# Declare the paths that require persistent external volume mounts.
# The Nix store holds all downloaded packages; the nix state directory holds
# the per-user profile state (nix profile add). Both must survive a recreate.
# Callers (e.g. marshal) are responsible for providing named volumes at these
# paths — anonymous volumes created by the runtime are not sufficient.
# Note: VOLUME does not expand ENV variables, so paths must be hardcoded and
# kept in sync with $NIX_STORE and $HOME manually. The corresponding
# io.ai-airbase.volume.* labels below use ENV vars and are the authoritative
# source — update both if these paths ever change.
VOLUME /nix/store
VOLUME /home/copilot/.local/state/nix


WORKDIR $WORKSPACE

# ARG and LABEL are last so that build metadata (especially CREATED timestamp)
# does not invalidate the cache for the expensive layers above.
ARG VERSION="dev"
ARG CREATED=""
ARG REVISION=""

LABEL org.opencontainers.image.title="revetment" \
      org.opencontainers.image.description="AI-Airbase revetment: isolated container environment for GitHub Copilot agents" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.created="${CREATED}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.source="https://github.com/rob-broadley/ai-airbase" \
      org.opencontainers.image.url="https://github.com/rob-broadley/ai-airbase" \
      org.opencontainers.image.licenses="AGPL-3.0-or-later" \
      org.opencontainers.image.vendor="Rob Broadley" \
      org.opencontainers.image.authors="Rob Broadley" \
      io.ai-airbase.component="revetment" \
      io.ai-airbase.volume.nix-store=$NIX_STORE \
      io.ai-airbase.volume.nix-profile=$HOME/.local/state/nix

CMD ["copilot"]
